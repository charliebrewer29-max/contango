# Contango build-time overrides (all optional).
# These are PUBLIC identifiers, not secrets — the app id is embedded in the
# shipped web bundle and the base URL is the public Base44 app origin.
# src/lib/app-params.js has committed fallbacks for the app id and base URL,
# so a bundled native build (Capacitor) works with none of these set.

# Base44 app id (defaults to the committed fallback in app-params.js).
# VITE_BASE44_APP_ID=

# Base44 app origin (defaults to https://app.base44.com).
# VITE_BASE44_APP_BASE_URL=

# Backend functions version tag (no fallback; omit for default).
# VITE_BASE44_FUNCTIONS_VERSION=