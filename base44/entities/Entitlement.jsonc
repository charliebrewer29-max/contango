{
  "name": "Entitlement",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "trial",
        "premium"
      ]
    },
    "trial_started": {
      "type": [
        "string",
        "null"
      ]
    },
    "trial_ends": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "trial",
        "revenuecat",
        "appstore",
        "dev"
      ]
    },
    "updated_at": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": [
    "user_id",
    "tier",
    "source",
    "updated_at"
  ]
}