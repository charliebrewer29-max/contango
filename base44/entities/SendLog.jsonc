{
  "name": "SendLog",
  "type": "object",
  "properties": {
    "reminder_id": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "attempt_count": {
      "type": "number"
    },
    "severity": {
      "type": "string",
      "enum": [
        "normal",
        "high"
      ]
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}