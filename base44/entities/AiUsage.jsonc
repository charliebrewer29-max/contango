{
  "name": "AiUsage",
  "type": "object",
  "properties": {
    "day": {
      "type": "string"
    },
    "count": {
      "type": "number"
    },
    "hour_bucket": {
      "type": "string"
    },
    "hour_count": {
      "type": "number"
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}